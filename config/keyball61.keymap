#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC            &kp N1            &kp N2        &kp N3        &kp N4     &kp N5                                         &kp N6      &kp N7  &kp N8     &kp N9      &kp N0         &mt DELETE MINUS
&kp TAB            &kp Q             &kp W         &kp E         &kp R      &kp T                                          &kp Y       &kp U   &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&kp CAPS           &kp A             &kp S         &kp D         &kp F      &kp G                                          &kp H       &kp J   &kp K      &kp L       &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT     &kp Z             &kp X         &kp C         &kp V      &kp B            &mkp LCLK       &mkp RCLK     &kp N       &kp M   &kp COMMA  &kp PERIOD  &kp SLASH      &mt RIGHT_SHIFT NON_US_HASH
&lt NUM LEFT_GUI   &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &mo SNIPE  &lt MOUSE SPACE  &mo SCROLL                  &kp RETURN  &lt SYM BACKSPACE                      &kp RIGHT_ALT  &lt SYM DELETE
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
// right hand: numpad. Symbols below are German-layout: Shift+8 = (  Shift+9 = )  AltGr+8 = [  AltGr+9 = ]  AltGr+7 = {  AltGr+0 = }
&trans  &trans  &trans  &trans  &trans  &trans                  &kp KP_SLASH     &kp KP_N7  &kp KP_N8   &kp KP_N9     &kp LS(N8)  &kp LS(N9)
&trans  &trans  &trans  &trans  &trans  &trans                  &kp KP_ASTERISK  &kp KP_N4  &kp KP_N5   &kp KP_N6     &kp RA(N8)  &kp RA(N9)
&trans  &trans  &trans  &trans  &trans  &trans                  &kp KP_MINUS     &kp KP_N1  &kp KP_N2   &kp KP_N3     &kp RA(N7)  &kp RA(N0)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_PLUS      &kp KP_N0  &kp KP_DOT  &kp KP_EQUAL  &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &kp KP_ENTER     &trans                               &trans      &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp C_BRI_UP   &kp F1               &kp F2         &kp F3        &kp F4             &kp F5                      &trans  &trans  &trans  &trans  &trans  &trans
&kp C_BRI_DN   &kp F6               &kp F7         &kp F8        &kp F9             &kp F10                     &trans  &trans  &trans  &trans  &trans  &trans
&trans         &kp F11              &kp F12        &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT                &trans  &trans  &trans  &trans  &trans  &trans
&trans         &bt BT_SEL 1         &bt BT_SEL 2   &bt BT_SEL 3  &kp C_MUTE         &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &to FUN  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR     &trans               &bt BT_PRV     &bt BT_NXT    &trans             &kp LG(L)          &trans              &trans  &trans                  &trans  &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
// mirrored left-hand keys on the right half; &to DEFAULT returns to the base layer
&trans  &trans            &trans  &trans  &trans            &trans                   &kp SPACE        &kp LEFT_ALT      &kp H   &kp M   &kp LEFT_CONTROL  &kp B
&trans  &trans            &trans  &trans  &trans            &trans                   &kp V            &kp C             &kp X   &kp Z   &kp LEFT_SHIFT    &kp CAPS
&trans  &trans            &trans  &trans  &trans            &trans                   &kp F            &kp D             &kp S   &kp A   &kp TAB           &kp J
&trans  &trans            &trans  &trans  &trans            &trans  &trans  &kp T     &kp R            &kp E             &kp W   &kp Q   &kp U             &mt LEFT_GUI N1
&trans  &trans            &trans  &trans  &trans            &trans  &trans            &kp I            &kp Y                             &to DEFAULT       &kp ESC
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans    &trans     &trans                  &kp LC(A)   &trans     &trans         &trans     &trans  &trans
&trans  &trans  &trans  &kp UP    &trans     &trans                  &kp LC(X)   &trans     &kp PAGE_UP    &trans     &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans                &kp LC(V)   &mkp LCLK  &mkp MCLK      &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans    &trans     &trans  &trans  &trans  &kp LC(C)   &mkp MB4   &kp PAGE_DOWN  &mkp MB5   &trans  &trans
&trans  &trans  &trans  &trans    &trans     &trans  &trans          &trans      &trans                    &trans     &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                  &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans    &trans     &trans                  &kp LC(A)   &trans     &trans         &trans     &trans  &trans
&trans  &trans  &trans  &kp UP    &trans     &trans                  &kp LC(X)   &trans     &kp PAGE_UP    &trans     &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans                &kp LC(V)   &mkp LCLK  &mkp MCLK      &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans    &trans     &trans  &trans  &trans  &kp LC(C)   &mkp MB4   &kp PAGE_DOWN  &mkp MB5   &trans  &trans
&trans  &trans  &trans  &trans    &trans     &trans  &trans          &trans      &trans                    &trans     &trans
            >;
        };
    };
};
